{
  "name": "jianjin-refiner",
  "productName": "渐进 Refiner",
  "version": "2.0.0",
  "description": "通用渐进式精化引擎桌面应用：粗略生成 → 细化 → 调整",
  "author": "GAOSICHUN",
  "main": "out/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.12",
    "diff": "^9.0.0",
    "js-yaml": "^5.4.3",
    "jsonrepair": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "remixicon": "^4.9.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.gaosichun.jianjin-refiner",
    "productName": "渐进 Refiner",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "executableName": "JianJinRefiner",
      "artifactName": "JianJin-Refiner-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "JianJin-Refiner-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "渐进 Refiner",
      "artifactName": "JianJin-Refiner-${version}-Setup.${ext}",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.invalid/jianjin-refiner/"
      }
    ]
  }
}